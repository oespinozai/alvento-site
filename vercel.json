{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [

    { "source": "/report/:token/", "destination": "/api/report/:token" },
    { "source": "/report/:token", "destination": "/api/report/:token" },
    { "source": "/tools", "destination": "/tools.html" },
    { "source": "/tools/pdf-to-markdown", "destination": "/tools/pdf-to-markdown/index.html" },
    { "source": "/tools/sop-to-checklist", "destination": "/tools/sop-to-checklist/index.html" },
    { "source": "/tools/psbar-statement-generator", "destination": "/tools/psbar-statement-generator/index.html" },
    { "source": "/tools/mdr-psur-outline-generator", "destination": "/tools/mdr-psur-outline-generator/index.html" },
    { "source": "/tools/mdr-technical-file-index", "destination": "/tools/mdr-technical-file-index/index.html" },
    { "source": "/tools/cpd-tracker", "destination": "/tools/cpd-tracker/index.html" },
    { "source": "/tools/udi-decoder", "destination": "/tools/udi-decoder/index.html" },
    { "source": "/tools/mdr-class-check", "destination": "/tools/mdr-class-check/index.html" },
    { "source": "/website-audit", "destination": "/website-audit.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/sample-audit-report", "destination": "/sample-audit-report.html" },
    { "source": "/audit-booked", "destination": "/audit-booked.html" },
    { "source": "/unsubscribe", "destination": "/api/unsubscribe" },
    { "source": "/unsubscribe/", "destination": "/api/unsubscribe" },
    { "source": "/score-api", "destination": "/score-api.html" },
    { "source": "/aeo", "destination": "/aeo.html" },
    { "source": "/projects/psur-draft-generator", "destination": "/projects/psur-draft-generator/index.html" }
  ],
  "redirects": [
    { "source": "/seo-audit", "destination": "/website-audit/", "permanent": true },
    { "source": "/seo-audit/", "destination": "/website-audit/", "permanent": true },
    { "source": "/email-plugin", "destination": "/", "permanent": true },
    { "source": "/email-plugin/", "destination": "/", "permanent": true },
    { "source": "/RegalMail", "destination": "/", "permanent": true },
    { "source": "/RegalMail/", "destination": "/", "permanent": true }
  ],
  "functions": {
    "api/audit.js": { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://foyer-demo.alvento.uk https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com; frame-src https://immunaris-case-study.vercel.app https://calendly.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        }
      ]
    }
  ]
}
